{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consultschedule",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "previews": {},
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "consultation.ajamlab.my",
      "custom_domain": true
    }
  ]
}
